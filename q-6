#include <iostream>
#include <cstring>
using namespace std;
class Text {
    char* str;
public:
    Text(const char* s = "") {
        str = new char[strlen(s) + 1];
        strcpy(str, s);
    }
    Text(const Text& t) {
        str = new char[strlen(t.str) + 1];
        strcpy(str, t.str);
    }
    Text& operator=(const Text& t) {
        if (this != &t) {
            char* temp = new char[strlen(t.str) + 1];
            strcpy(temp, t.str);
            delete[] str;
            str = temp;
        }
        return *this;
    }
    Text operator+(const Text& t) const {
        char* temp = new char[strlen(str) + strlen(t.str) + 1];
        strcpy(temp, str);
        strcat(temp, t.str);
        Text result(temp);
        delete[] temp;
        return result;
    }
    bool operator==(const Text& t) const {
        return strcmp(str, t.str) == 0;
    }
    bool operator!=(const Text& t) const {
        return !(*this == t);
    }
    friend ostream& operator<<(ostream& out, const Text& t) {
        return out << t.str;
    }
    ~Text() {
        delete[] str;
    }
};
int main() {
    Text a("Hello "), b("World");
    Text c = a + b;
    cout << "Combined: " << c << endl;
    cout << "Equal: " << (a == b) << endl;
    cout << "Not Equal: " << (a != b) << endl;
    Text d = c;
    cout << "Copied: " << d << endl;
    d = a;
    cout << "Assigned: " << d << endl;
    d = d;
    cout << "Self Assignment: " << d << endl;
    Text empty("");
    cout << "Empty Text: [" << empty << "]" << endl;
    Text longText("This is a longer SMS message for testing.");
    cout << "Long Text: " << longText << endl;
    return 0;
}
