#include <iostream>
#include <vector>
#include <string>
#include <stdexcept>
using namespace std;

class Time {
    int s;
public:
    Time(int x = 0) : s(x) {}

    Time& operator++() {
        ++s;
        return *this;
    }

    Time operator++(int) {
        Time old = *this;
        ++s;
        return old;
    }

    bool operator==(const Time& t) const {
        return s == t.s;
    }

    bool operator<(const Time& t) const {
        return s < t.s;
    }

    void show() const {
        cout << s / 3600 << ":"
             << (s / 60) % 60 << ":"
             << s % 60 << endl;
    }
};

class Playlist {
    vector<string> songs = {"Song A", "Song B", "Song C"};
public:
    string& operator[](int i) {
        if (i < 0 || i >= (int)songs.size())
            throw out_of_range("Invalid index");
        return songs[i];
    }

    const string& operator[](int i) const {
        if (i < 0 || i >= (int)songs.size())
            throw out_of_range("Invalid index");
        return songs[i];
    }
};

int main() {
    Time t(5);
    Time a = t++;
    Time b = ++t;

    cout << "a = "; a.show();
    cout << "b = "; b.show();
    cout << "t = "; t.show();

    cout << "Equal: " << (a == b) << endl;
    cout << "Less: " << (a < b) << endl;

    Playlist p;
    cout << "Playing: " << p[0] << endl;
    p[0] = "New Song";
    cout << "Updated: " << p[0] << endl;

    const Playlist& cp = p;
    cout << "Next: " << cp[1] << endl;

    try {
        cout << p[-1] << endl;
    } catch (const out_of_range& e) {
        cout << e.what() << endl;
    }

    try {
        cout << p[3] << endl;
    } catch (const out_of_range& e) {
        cout << e.what() << endl;
    }

    Time rollover(3599);
    ++rollover;
    cout << "Rollover: ";
    rollover.show();
}
