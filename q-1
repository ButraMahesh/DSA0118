
#include <iostream>
#include <string>
#include <stdexcept>
using namespace std;
class Book
{
    string title;
    string author;
    int copies;
public:
    Book() : Book("Unknown", "Unknown", 0)
    {
        cout << "Default constructor called" << endl;
    }
    Book(string t) : Book(t, "Unknown", 1)
    {
        cout << "Title constructor called" << endl;
    }
    Book(string t, string a, int c)
        : title(t), author(a), copies(c)
    {
        if (copies < 0)
        {
            throw invalid_argument("Copies cannot be negative");
        }
        cout << "Parameterized constructor called" << endl;
    }
    void display() const
    {
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Copies: " << copies << endl;
        cout << "----------------------" << endl;
    }
};
class ExplicitBook
{
    string title;
public:
    explicit ExplicitBook(string t) : title(t) {}

    void display()
    {
        cout << "Explicit Book: " << title << endl;
    }
};
class WrongOrder
{
    int x;
    int y;

public:
    WrongOrder() : y(20), x(y + 10)
    {
        cout << "x = " << x << ", y = " << y << endl;
    }
};
int main()
{
    cout << "Q1: CONSTRUCTORS AND CONSTRUCTOR OVERLOADING" << endl;
    cout << "============================================" << endl;
    try
    {
        cout << "\n1. Creating Book Objects\n";

        Book b1;
        Book b2("C++ Programming");
        Book b3("Data Structures", "Mark Allen", 10);
        cout << "\n2. Book Details\n";
        b1.display();
        b2.display();
        b3.display();
        cout << "\n3. Testing Negative Copies\n";
        Book b4("Invalid Book", "Unknown", -5);
        b4.display();
    }
    catch (const exception& e)
    {
        cout << "Error: " << e.what() << endl;
    }
    cout << "\n4. Explicit Constructor Demonstration\n";

    ExplicitBook b5("Programming in C++");
    b5.display();
    cout << "\n5. Constructor Initialization Order\n";
    WrongOrder w1;
    cout << "\n6. Program Completed Successfully" << endl;
    return 0;
}
