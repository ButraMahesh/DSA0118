#include <iostream>
using namespace std;

class SmartCard {
private:
    long long balance;

public:
    SmartCard(long long b) {
        balance = b;
    }

    bool canTravel(long long fare) {
        return fare >= 0 && balance >= fare + 5000;
    }

    void deduct(long long fare) {
        if (canTravel(fare)) {
            balance -= fare;
            cout << "Journey Allowed" << endl;
        } else {
            cout << "Journey Denied" << endl;
        }
    }

    void display() {
        cout << "Balance: Rs " << balance / 100 << endl;
    }
};

int main() {
    SmartCard card(10000);
    card.deduct(2000);
    card.display();

    return 0;
}
