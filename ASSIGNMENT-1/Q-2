#include <iostream>
using namespace std;

enum class Zone { Inner, Middle, Outer };

constexpr int BASE_FARE[] = {1000, 2000, 3000};
constexpr int PEAK_SURCHARGE = 20;
constexpr int MIN_BALANCE = 5000;

int main() {
    Zone z = Zone::Middle;
    int fare = BASE_FARE[static_cast<int>(z)];

    cout << "Base Fare: Rs " << fare / 100 << endl;
    cout << "Peak Surcharge: " << PEAK_SURCHARGE << "%" << endl;
    cout << "Minimum Balance: Rs " << MIN_BALANCE / 100;

    return 0;
}
