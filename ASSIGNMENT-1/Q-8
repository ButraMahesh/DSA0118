
#include <iostream>
#include <iomanip>
#include <limits>
using namespace std;

class MetroCard {
private:
    long long balance = 10000;

public:
    void journey(int zone) {
        long long fare;

        if (zone == 1)
            fare = 1000;
        else if (zone == 2)
            fare = 2000;
        else if (zone == 3)
            fare = 3000;
        else {
            cout << "Invalid Zone" << endl;
            return;
        }

        cout << fixed << setprecision(2);
        cout << "\n--- Journey Report ---" << endl;
        cout << "Zone: " << zone << endl;
        cout << "Fare: Rs " << fare / 100 << "."
             << setw(2) << setfill('0') << fare % 100
             << setfill(' ') << endl;

        if (balance >= fare + 5000) {
            balance -= fare;
            cout << "Status: Journey Allowed" << endl;
        } else {
            cout << "Status: Journey Denied" << endl;
        }

        cout << "Remaining Balance: Rs "
             << balance / 100 << "."
             << setw(2) << setfill('0') << balance % 100
             << endl;
    }
};

int main() {
    MetroCard card;
    int zone;

    cout << "Enter Zone (1-Inner, 2-Middle, 3-Outer): ";

    while (!(cin >> zone) || zone < 1 || zone > 3) {
        if (cin.eof()) {
            cout << "\nNo valid input provided." << endl;
            return 1;
        }

        cout << "Invalid Input! Try again: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    card.journey(zone);
    return 0;
}
